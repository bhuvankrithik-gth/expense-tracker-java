# Copy this file to ".env" and fill in your own values.
# The app reads these from ENVIRONMENT VARIABLES — nothing is hardcoded.
# (For local runs you can also export them in your shell.)

# MySQL connection (plain JDBC, see com.expensetracker.dao.Db)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expensetracker
DB_USER=etuser
DB_PASSWORD=change-me

# Port the built-in HttpServer listens on
APP_PORT=8080

# Optional: reach MySQL through a Unix-domain socket instead of TCP.
# Only needed in sandboxed environments where the JVM cannot open raw
# TCP connections (a mysql-bridge.py sidecar must be listening here).
# Leave unset for normal deployments.
# DB_SOCKET=/tmp/mysql-bridge.sock
